{
  "name": "souvenir",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/gen-lingo.ts && next dev",
    "dev:https": "node scripts/gen-lingo.ts && next dev --experimental-https -H 0.0.0.0",
    "build": "node scripts/gen-lingo.ts && next build",
    "lingo:gen": "node scripts/gen-lingo.ts",
    "start": "next start",
    "lint": "biome check .",
    "postinstall": "if [ -f scripts/gen-lingo.ts ]; then node scripts/gen-lingo.ts; fi",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "stats": "node --env-file-if-exists=.env scripts/stats.ts",
    "recovery:link": "node --env-file-if-exists=.env scripts/recovery-link.ts",
    "speech:check": "node --env-file-if-exists=.env scripts/speech-check.ts",
    "prepare": "husky",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.6.0"
}
