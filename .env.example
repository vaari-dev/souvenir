# Copy to .env and fill in. Validated in lib/env.ts.

# Postgres. Defaults match `docker compose up db`; keep the DATABASE_URL port equal to DB_PORT
# (the host port the container maps to).
DB_PORT=5566
DATABASE_URL=postgres://souvenir:souvenir@127.0.0.1:5566/souvenir

# APP_PORT is docker's host port; PORT drives `next dev`/`next start` without docker. APP_BIND
# is the interface docker binds: loopback by default, behind a reverse proxy; 0.0.0.0 exposes it.
APP_PORT=3004
APP_BIND=127.0.0.1

# Postgres password for docker compose. Use a strong one in production.
POSTGRES_PASSWORD=souvenir

# Signs sessions; rotating it signs everyone out. Required, min 16 chars:
# `openssl rand -base64 32`
AUTH_SECRET=
# Public URL of the app. The Google redirect URI is built from it, and https:// marks the
# session cookie Secure. Use localhost, not 127.0.0.1: an IP is not a valid passkey rp id.
AUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials).
# Authorised redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Passwordless fake login. Local development only; never true in production.
AUTH_DEV_LOGIN=false

# Logging (pino): fatal | error | warn | info | debug | trace | silent.
# Unset means info in production and debug in development.
# LOG_LEVEL=info

# Resolved predictions needed to be ranked on the leaderboard.
RANKED_MIN_RESOLVED=5

# Optional: LLM polish for market drafts, via any Anthropic-compatible API.
# For MiniMax M3: LLM_BASE_URL=https://api.minimax.io/anthropic
LLM_BASE_URL=https://api.minimax.io/anthropic
LLM_API_KEY=
LLM_MODEL=MiniMax-M3

# Optional /talk voice for phones with none of their own: MiniMax's /v1/t2a_v2, same key as
# LLM_API_KEY. Unset, the device speaks if it can.
SPEECH_BASE_URL=
SPEECH_API_KEY=
SPEECH_TTS_MODEL=speech-2.6-turbo
SPEECH_GROUP_ID=

# One voice per language code (lib/talk.ts), comma-separated. MiniMax voices are cross-lingual,
# so a language with no entry falls back to the side's voice; the local side has no fallback
# unless SPEECH_VOICE_THEM names one, since one deploy serves trips everywhere. The local side
# is pitched down (semitones, -12 to 12) and slowed. `POST /v1/get_voice` lists an account's
# voices; `pnpm speech:check` hears every language once. Blank is the same as unset.
SPEECH_VOICES=th=Thai_male_1_sample8
SPEECH_VOICE_US=hindi_female_1_v2
SPEECH_VOICE_THEM=
SPEECH_VOICE_THEM_PITCH=-5
SPEECH_VOICE_THEM_SPEED=0.9

# Source of the day's exchange rate (lib/fx.ts): any host serving currency-api's shape,
# /v1/currencies/{code}.min.json. Unreachable, each currency settles on its own.
# FX_BASE_URL=https://latest.currency-api.pages.dev

# Shown on /privacy: the grievance address, and where a member asks to verify the build.
# CONTACT_EMAIL=you@example.com

# External docker network the app joins so the box's reverse proxy can reach it. Must already
# exist (`docker network create edge`); blank means "edge".
DOCKER_NETWORK=edge
